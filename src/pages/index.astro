---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout>
  <section>
    <h2>計算ツール</h2>
    <a class="tool-link" href={withBase('tools/voltage-divider/')}>
      <strong>分圧抵抗計算</strong>
      <span>E12 / E24 の抵抗候補を、目標電圧との誤差順に比較します。 →</span>
    </a>
  </section>
  <section>
    <h2>技術資料</h2>
    <a class="tool-link" href={withBase('tools/e-series/')}>
      <strong>E系列標準値一覧</strong>
      <span>E3〜E192の標準値を比較し、系列ごとにコピーできます。 →</span>
    </a>
  </section>
  <section>
    <h2>このサイトについて</h2>
    <p>
      <a href={withBase('about/')}>About</a> — 作者・ライセンス・ご利用にあたって
    </p>
  </section>
</BaseLayout>
<style>
  section {
    margin-bottom: 2rem;
  }
  .tool-link {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    text-decoration: none;
  }
  .tool-link span {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
