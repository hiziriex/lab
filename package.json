{
  "name": "hiziriex-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "astro sync && eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert \"@visual|@a11y\"",
    "test:visual": "playwright test --grep @visual --project=chromium --project=android --update-snapshots=none",
    "test:a11y": "playwright test --grep @a11y",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "check": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "prepare": "husky",
    "bundle": "node scripts/bundle-report.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "optimize:svg": "svgo -f public/circuits",
    "audit:check": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/themes": "^3.3.0",
    "astro": "^7.4.0",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "storybook": "^10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
